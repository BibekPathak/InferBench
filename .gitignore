# Byte-compiled / optimized / cache
__pycache__/
*.py[cod]
*$py.class
*.so

# Distribution / packaging
build/
dist/
*.egg-info/
.eggs/

# Virtual environments
.venv/
venv/
env/

# Test / coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/

# InferBench runtime artifacts (raw data, summaries, reports, local DBs).
# These are reproducible outputs; do not commit measured results by accident.
runs/
*.db
*.sqlite
*.sqlite3
!tests/fixtures/*.jsonl

# Editor / OS noise
.vscode/
.idea/
.DS_Store

# Local environment overrides
.env
.env.local
